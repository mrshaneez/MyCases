{
  // Tells Cloudflare this Worker serves the built site, not the repo root.
  // Without it, index.html is served straight from the repo and its script tag
  // points at raw JSX, which the browser cannot parse — a blank page.
  "name": "mycases",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
